# MoneyLens AI Environment Configuration Example
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Settings
DATABASE_URL=sqlite:///./moneylens.db

# Optional AI LLM Integration (Google Gemini API Key)
# If left empty, MoneyLens AI uses its deterministic NLP query & insights engine fallback seamlessly.
GEMINI_API_KEY=

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
